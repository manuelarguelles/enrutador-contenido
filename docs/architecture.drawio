okeWidth=2;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;dashed=0;" edge="1" parent="1" source="rrf" target="results"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="modelo local verificado" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#4a5560;strokeWidth=2;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="model" target="e5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="persiste índice" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#4a5560;strokeWidth=2;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="normalize" target="index"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="1" style="ellipse;html=1;fillColor=#0b5cad;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="28" y="208" width="26" height="26" as="geometry"/></mxCell><mxCell id="c20" value="2" style="ellipse;html=1;fillColor=#0b5cad;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="233" y="213" width="26" height="26" as="geometry"/></mxCell><mxCell id="c21" value="3" style="ellipse;html=1;fillColor=#0b5cad;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="378" y="263" width="26" height="26" as="geometry"/></mxCell><mxCell id="c22" value="4" style="ellipse;html=1;fillColor=#0b5cad;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="553" y="208" width="26" height="26" as="geometry"/></mxCell><mxCell id="c23" value="5" style="ellipse;html=1;fillColor=#0b5cad;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="718" y="208" width="26" height="26" as="geometry"/></mxCell><mxCell id="c24" value="6" style="ellipse;html=1;fillColor=#0b5cad;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="888" y="208" width="26" height="26" as="geometry"/></mxCell><mxCell id="c25" value="7" style="ellipse;html=1;fillColor=#0b5cad;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1058" y="108" width="26" height="26" as="geometry"/></mxCell><mxCell id="c26" value="8" style="ellipse;html=1;fillColor=#0b5cad;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1058" y="318" width="26" height="26" as="geometry"/></mxCell><mxCell id="c27" value="9" style="ellipse;html=1;fillColor=#0b5cad;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1218" y="208" width="26" height="26" as="geometry"/></mxCell><mxCell id="c28" value="10" style="ellipse;html=1;fillColor=#0b5cad;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1413" y="208" width="26" height="26" as="geometry"/></mxCell><mxCell id="leg" value="&lt;b&gt;Qué ocurre en cada paso&lt;/b&gt;&lt;br&gt;1  El usuario opera desde terminal o desde un agente.&lt;br&gt;2  OpenClaw y Claude Code son entradas opcionales; no contienen el motor.&lt;br&gt;3  Los launchers project-scoped enlazan de forma explícita al repositorio.&lt;br&gt;4  Una sola CLI gobierna validación, indexación y búsqueda.&lt;br&gt;5  JSON Schema y el control de URL rechazan registros incompatibles o inseguros.&lt;br&gt;6  El texto se normaliza una vez para los dos recuperadores.&lt;br&gt;7  BM25 produce el ranking léxico.&lt;br&gt;8  E5 fijado por revisión produce embeddings locales y ranking por coseno.&lt;br&gt;9  RRF combina ambos rankings de forma determinista.&lt;br&gt;10 Los resultados JSON conservan score, rank y razón de recuperación; la interfaz los devuelve al usuario." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=11;fillColor=#ffffff;strokeColor=#c3cad3;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="650" width="1180" height="220" as="geometry"/></mxCell><mxCell id="key" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;Naranja: entrada · Verde: servicio · Amarillo: guardrail · Azul: datos · Rosa: persona · Rojo: externo · Línea discontinua: relación secundaria." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=11;fillColor=#ffffff;strokeColor=#c3cad3;spacing=8;" vertex="1" parent="1"><mxGeometry x="1215" y="650" width="310" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>